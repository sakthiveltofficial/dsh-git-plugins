{
  "name": "@dsh-git/bundle",
  "version": "0.1.2",
  "description": "Profile bundle for the dsh-git plugin suite: one `dsh plugin --profile <name> add @dsh-git/bundle` installs and wires the full git capability (local git, all hosted platforms, self-evolving memory, and the model-facing tools) into a DSH profile.",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "echo '@dsh-git/bundle: config-only, nothing to build'"
  },
  "dependencies": {
    "@dsh-git/azuredevops": "^0.1.2",
    "@dsh-git/bitbucket": "^0.1.2",
    "@dsh-git/core": "^0.1.2",
    "@dsh-git/gitea": "^0.1.2",
    "@dsh-git/github": "^0.1.2",
    "@dsh-git/gitlab": "^0.1.2",
    "@dsh-git/local": "^0.1.2",
    "@dsh-git/memory": "^0.1.2",
    "@dsh-git/platform": "^0.1.2",
    "@dsh-git/tool-git": "^0.1.2",
    "@dsh-git/tool-git-memory": "^0.1.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "git",
    "plugin-bundle",
    "source-control",
    "install"
  ]
}
