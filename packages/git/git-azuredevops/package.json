{
  "name": "@dsh-git/azuredevops",
  "version": "0.1.0",
  "description": "Azure DevOps adapter for gitPlatform: Git REST + Build + Work Item APIs over Node fetch, normalized into the gitPlatform vocabulary. Issues map to Work Items; releases and security alerts are unsupported.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@dsh-git/core": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "typescript": "^5.5.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "git",
    "azure-devops",
    "azure",
    "pipelines"
  ]
}
