{
  "name": "dsh-git-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Git / source-control plugins for DeepSeek Harness: a local-git provider, a hosted-platform registry (GitHub/GitLab/Bitbucket/Azure DevOps/Gitea), and grouped model-facing tools.",
  "scripts": {
    "prepare": "pnpm -r run build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf lib",
    "smoke": "node scripts/smoke-local.mjs",
    "smoke:all": "node scripts/smoke-local.mjs && node scripts/smoke-platform.mjs && node scripts/smoke-adapters.mjs && node scripts/smoke-memory.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-git/azuredevops": "workspace:*",
    "@dsh-git/bitbucket": "workspace:*",
    "@dsh-git/core": "workspace:*",
    "@dsh-git/gitea": "workspace:*",
    "@dsh-git/github": "workspace:*",
    "@dsh-git/gitlab": "workspace:*",
    "@dsh-git/local": "workspace:*",
    "@dsh-git/memory": "workspace:*",
    "@dsh-git/platform": "workspace:*",
    "@dsh-git/tool-git": "workspace:*",
    "@dsh-git/tool-git-memory": "workspace:*"
  }
}
